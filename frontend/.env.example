# Optional: custom API base (e.g. your own proxy). Leave empty for `/openrouter-api`
# (Vite dev/preview proxy, or your host must forward that path to OpenRouter).
# Do not use https://openrouter.ai/api/v1 - browser CORS will break the app.
VITE_OPENROUTER_API_BASE=

# Optional: max completion tokens per request (default 16384)
VITE_OPENROUTER_MAX_OUTPUT_TOKENS=

# Optional: Cloudflare web analytics beacon URL
VITE_CF_ANALYTICS_BEACON_URL=

# Optional: chat sidebar links (defaults: teamtesthub.us feedback, GitHub search for download)
# VITE_FEEDBACK_URL=https://example.com/contact
# VITE_DOWNLOAD_APP_URL=https://github.com/your-org/your-repo
